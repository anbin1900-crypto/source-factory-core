{
  "rule_id": "SOURCE_FACTORY_WINDOWS_POWERSHELL51_EXPANDABLE_STRING_COLON_RULE_V1",
  "rule_version": "1.0.0",
  "registered_at": "2026-07-31T05:48:00+09:00",
  "status": "ACTIVE_BLOCKING_STATIC_RULE",
  "scope": {
    "language": "Windows PowerShell",
    "minimum_target": "5.1 Desktop",
    "file_extensions": [
      ".ps1",
      ".psm1",
      ".psd1"
    ],
    "string_kinds": [
      "double_quoted_expandable_string",
      "double_quoted_expandable_here_string"
    ]
  },
  "rule": {
    "statement": "Windows PowerShell 5.1 expandable string에서 일반 변수 바로 뒤에 콜론이 오면 반드시 ${var}: 형식으로 감싼다.",
    "required_form": "${var}:",
    "reason": "일반 변수명 뒤의 콜론은 PowerShell 변수 Scope 또는 Drive 구문으로 해석될 수 있으므로 변수 경계를 중괄호로 명시해야 한다.",
    "severity": "ERROR",
    "gate_effect": "FAIL_STATIC_VALIDATION"
  },
  "forbidden_examples": [
    "\"$Case:\"",
    "\"$path:\"",
    "\"$lfRaw:\"",
    "\"$crlfRaw:\"",
    "\"$lfBlob:\""
  ],
  "required_corrections": [
    "\"${Case}:\"",
    "\"${path}:\"",
    "\"${lfRaw}:\"",
    "\"${crlfRaw}:\"",
    "\"${lfBlob}:\""
  ],
  "allowed_scope_prefix_exceptions": [
    "$env:",
    "$script:",
    "$global:",
    "$local:",
    "$private:",
    "$using:",
    "$this:"
  ],
  "detection_contract": {
    "candidate_pattern_description": "Expandable string 내부의 $<simpleVariableName>: 후보를 탐지한다.",
    "simple_variable_name_pattern": "[A-Za-z_][A-Za-z0-9_]*",
    "exclude_scope_prefixes_case_insensitive": true,
    "parser_confirmation_required": true,
    "false_positive_policy": "예약 Scope 예외 외의 일반 변수+콜론은 위반으로 판정한다."
  },
  "enforcement": {
    "new_or_modified_powershell_source": "MANDATORY",
    "legacy_immutable_source": "REPORT_ONLY_UNLESS_TOUCHED",
    "required_receipt_fields": [
      "files_scanned",
      "candidate_findings",
      "scope_exception_findings",
      "violations",
      "violation_paths",
      "violation_lines",
      "final_status"
    ],
    "pass_condition": "violations == 0"
  },
  "regression_cases": [
    {
      "case_id": "GENERAL_VARIABLE_COLON_REJECT",
      "source": "Write-Output \"$Case:\"",
      "expected": "FAIL"
    },
    {
      "case_id": "BRACED_GENERAL_VARIABLE_COLON_ACCEPT",
      "source": "Write-Output \"${Case}:\"",
      "expected": "PASS"
    },
    {
      "case_id": "ENV_SCOPE_ACCEPT",
      "source": "Write-Output \"$env:PATH\"",
      "expected": "PASS"
    },
    {
      "case_id": "SCRIPT_SCOPE_ACCEPT",
      "source": "Write-Output \"$script:State\"",
      "expected": "PASS"
    },
    {
      "case_id": "EXPANDABLE_HERE_STRING_REJECT",
      "source": "@\"\n$path:\n\"@",
      "expected": "FAIL"
    },
    {
      "case_id": "EXPANDABLE_HERE_STRING_ACCEPT",
      "source": "@\"\n${path}:\n\"@",
      "expected": "PASS"
    }
  ]
}
