{
  "rule_id": "SOURCE_FACTORY_BC12_BOTTLENECK_SWARM_AND_COMMANDER_INTEGRATION_RULE_V1",
  "version": "1.0.0",
  "registered_at": "2026-07-31T16:29:00+09:00",
  "status": "ACTIVE_OPERATIONAL_RULE",
  "purpose": "A-4와 같은 중요 병목 발생 시 B그룹 6명과 C그룹 6명에게 동일 병목을 서로 다른 해결 관점으로 병렬 배정하고, 현재 통합 커맨더가 증거기반으로 최종안을 선택·결합한다.",
  "trigger": {
    "activate_when_any": [
      "critical_path_blocked",
      "same_issue_failed_two_or_more_iterations",
      "root_cause_uncertain_with_multiple_plausible_classes",
      "single_worker_solution_does_not_establish_native_runtime_evidence",
      "external_runtime_or_environment_failure_masks_source_correctness"
    ],
    "do_not_activate_for": [
      "known_trivial_fix",
      "single_deterministic_typo_with_verified_patch",
      "production_emergency_requiring_one_owner",
      "exclusive_runtime_execution_that_cannot_be_parallelized"
    ]
  },
  "worker_pool": {
    "groups": ["B", "C"],
    "worker_count": 12,
    "workers": ["B-1", "B-2", "B-3", "B-4", "B-5", "B-6", "C-1", "C-2", "C-3", "C-4", "C-5", "C-6"]
  },
  "common_input_contract": {
    "same_problem_statement": true,
    "same_exact_source_head": true,
    "same_failure_receipt": true,
    "same_allowed_paths": true,
    "same_forbidden_effects": true,
    "same_acceptance_criteria": true
  },
  "divergent_lane_contract": [
    {"worker": "B-1", "lane": "ROOT_CAUSE_AND_FAILURE_BOUNDARY"},
    {"worker": "B-2", "lane": "MINIMAL_REPRODUCER_AND_EXACT_INPUT_LOCK"},
    {"worker": "B-3", "lane": "MINIMAL_PATCH_OR_SOURCE_CORRECTION"},
    {"worker": "B-4", "lane": "ALTERNATIVE_IMPLEMENTATION_PATH"},
    {"worker": "B-5", "lane": "COMPATIBILITY_AND_PLATFORM_MATRIX"},
    {"worker": "B-6", "lane": "SAFE_NATIVE_RUNTIME_EXECUTION_PLAN"},
    {"worker": "C-1", "lane": "STATIC_ANALYZER_AND_REUSABLE_RULE"},
    {"worker": "C-2", "lane": "FIXTURE_AND_EDGE_CASE_MATRIX"},
    {"worker": "C-3", "lane": "FAILURE_INJECTION_AND_NEGATIVE_TEST"},
    {"worker": "C-4", "lane": "ROLLBACK_NO_MUTATION_AND_BOUNDARY_AUDIT"},
    {"worker": "C-5", "lane": "SOURCE_FACTORY_CORE_REUSE_OR_ADAPTER_PATH"},
    {"worker": "C-6", "lane": "INDEPENDENT_RED_TEAM_AND_CROSS_SOLUTION_COMPARISON"}
  ],
  "mutation_policy": {
    "default_mode": "ANALYSIS_FIXTURE_TEST_PROPOSAL_ONLY",
    "parallel_mutation_of_same_canonical_source": false,
    "worker_specific_branch_or_owned_root_required": true,
    "canonical_source_mutation_owner": "COMMANDER_SELECTED_SINGLE_INTEGRATOR",
    "runtime_execution_owner": "COMMANDER_SELECTED_SINGLE_EXECUTOR"
  },
  "required_worker_output": [
    "root_cause_hypothesis",
    "evidence",
    "proposed_method",
    "exact_files_or_commands",
    "expected_result",
    "risks",
    "rollback",
    "acceptance_test",
    "status_pass_blocked_or_fail"
  ],
  "commander_integration": {
    "blind_majority_vote_forbidden": true,
    "selection_basis": [
      "remote_evidence",
      "reproducibility",
      "minimal_mutation",
      "native_runtime_proof",
      "rollback_safety",
      "cross_lane_agreement",
      "independent_red_team_result"
    ],
    "allowed_integration": "select_one_or_combine_compatible_parts",
    "final_integrator_count": 1,
    "final_executor_count": 1,
    "final_acceptance_auditor_minimum": 1
  },
  "resource_policy": {
    "analysis_and_static_jobs_may_run_in_parallel": true,
    "source_jobs_max_parallel": 3,
    "build_jobs_max_parallel": 2,
    "browser_jobs_max_parallel": 2,
    "exclusive_runtime_jobs_max_parallel": 1,
    "notex_exclusive_owner_preserved": true
  },
  "terminal_events": {
    "start": "BC12_BOTTLENECK_SWARM_STARTED",
    "worker_terminal": "BC12_WORKER_LANE_TERMINAL",
    "integration": "BC12_COMMANDER_SOLUTION_INTEGRATED",
    "pass": "BC12_BOTTLENECK_RESOLUTION_ACCEPTANCE_PASS",
    "blocked": "BC12_BOTTLENECK_RESOLUTION_BLOCKED"
  },
  "non_negotiable": [
    "Twelve workers must not overwrite the same canonical source concurrently.",
    "Different lanes must produce materially different methods or evidence.",
    "A static consensus is not a runtime PASS.",
    "Only the commander-selected integrator may publish the integrated candidate.",
    "Only one selected executor may use an exclusive runtime target.",
    "All rejected approaches remain as evidence and future regression inputs."
  ]
}
