{
  "schema_version": "EPIC_TO_PC_AGENT_DB_MAPPING_V1",
  "status": "ACTIVE_COMPATIBILITY_LAYER",
  "policy_id": "YOLLA_AUTOMATION_COMMON_RULES_V2",
  "database_schema": ".yolla/automation/PC_AGENT_AUTOMATION_DB_V1.sql",
  "database_engine": "SQLite 3",
  "default_database_path": "<LOCAL_DURABLE_FILE_QUEUE_V1_ROOT>/automation.db",
  "authority_model": {
    "official_input": "GitHub Remote Commit의 EPIC.json",
    "official_result": "GitHub Remote Commit의 RESULT.json",
    "official_runtime_schedule": "WORKER_JOB_SCHEDULE_V1",
    "local_database_role": "REBUILDABLE_NON_AUTHORITATIVE_PROJECTION",
    "pr_comment_role": "POINTER_ONLY",
    "source_json_immutable": true,
    "database_may_be_rebuilt": true
  },
  "import_preconditions": [
    "COMMANDER_EPIC_SUBMISSION_V2 Schema PASS",
    "GitHub EPIC.json Commit SHA Readback PASS",
    "다운로드 EPIC.json SHA-256과 GitHub 등록 SHA-256 일치",
    "worker_id·worker_slot_uid·epic_id·directive_id 고유성 PASS",
    "워커별 sequence 1부터 연속",
    "depends_on 참조 유효·순환 없음",
    "Worker Route 활성 여부 확인",
    "미치환 Placeholder 및 비밀정보 없음"
  ],
  "transaction": {
    "mode": "BEGIN_IMMEDIATE",
    "idempotency_key": "package_id + epic_commit_sha + epic_sha256",
    "on_existing_same_bytes": "NO_OP_AND_RECONCILE",
    "on_existing_different_bytes": "REJECT_PACKAGE_ID_REUSE",
    "on_failure": "ROLLBACK"
  },
  "field_mappings": [
    {"source":"schema_version","table":"automation_packages","column":"schema_version"},
    {"source":"package_id","table":"automation_packages","column":"package_id"},
    {"source":"project_id","table":"automation_packages","column":"project_id"},
    {"source":"group_id","table":"automation_packages","column":"group_id"},
    {"source":"commander_id","table":"automation_packages","column":"commander_id"},
    {"source":"created_at","table":"automation_packages","column":"created_at"},
    {"source":"registration.repository","table":"automation_packages","column":"registration_repository"},
    {"source":"registration.pr_number","table":"automation_packages","column":"registration_pr_number"},
    {"source":"registration.branch","table":"automation_packages","column":"registration_branch"},
    {"source":"registration.epic_file_path","table":"automation_packages","column":"epic_file_path"},
    {"source":"$raw_canonical_json","table":"automation_packages","column":"source_json"},
    {"source":"$github_commit_sha","table":"automation_packages","column":"epic_commit_sha"},
    {"source":"$epic_sha256","table":"automation_packages","column":"epic_sha256"},
    {"source":"workers[].worker_id","table":"automation_workers","column":"worker_id"},
    {"source":"workers[].worker_slot_uid","table":"automation_workers","column":"worker_slot_uid"},
    {"source":"workers[].repository","table":"automation_workers","column":"repository"},
    {"source":"workers[].control_pr","table":"automation_workers","column":"control_pr"},
    {"source":"workers[].enabled","table":"automation_workers","column":"enabled"},
    {"source":"workers[].epics[].epic_id","table":"automation_epics","column":"epic_id"},
    {"source":"workers[].epics[].sequence","table":"automation_epics","column":"sequence"},
    {"source":"workers[].epics[].directive_id","table":"automation_epics","column":"directive_id"},
    {"source":"workers[].epics[].title","table":"automation_epics","column":"title"},
    {"source":"workers[].epics[].instruction","table":"automation_epics","column":"instruction"},
    {"source":"workers[].epics[].done_when","table":"automation_epics","column":"done_when_json","encoding":"canonical JSON array"},
    {"source":"workers[].epics[].expected_terminal","table":"automation_epics","column":"expected_terminal_json","encoding":"canonical JSON array"},
    {"source":"workers[].epics[].retry_limit","table":"automation_epics","column":"retry_limit"},
    {"source":"workers[].epics[].depends_on[]","table":"automation_epic_dependencies","columns":["epic_id","depends_on_epic_id"]}
  ],
  "runtime_generated_fields": {
    "command_id": "CMD--<PACKAGE_ID>--<EPIC_ID>",
    "cycle_id": "<PACKAGE_ID>",
    "wave_id": "SEQ-<SEQUENCE_3_DIGITS>",
    "assignment_id": "<EPIC_ID>",
    "source_github_ref": "<REPOSITORY>@<EPIC_COMMIT_SHA>:<EPIC_FILE_PATH>",
    "duplicate_prompt_key": "기존 p1CommandCorrelationContract.buildIdempotencyKey가 생성",
    "work_id": "기존 LOCAL_DURABLE_FILE_QUEUE_V1 Runtime이 생성",
    "execution_id": "기존 Runtime이 생성",
    "attempt_id": "기존 Runtime이 생성",
    "payload_sha256": "기존 Queue Payload canonical bytes의 SHA-256"
  },
  "status_projection": {
    "package_statuses": ["IMPORTED","VALIDATED","RUNNING","PARTIAL_BLOCKED","COMPLETED","REJECTED"],
    "epic_statuses": ["PENDING","READY","DISPATCHING","RUNNING","RESULT_WAITING","PASS","RETRY_READY","BLOCKED_EXTERNAL","WAIT_DEPENDENCY","NEEDS_REPLAN"],
    "source_of_truth": "GitHub committed RESULT.json + WORKER_JOB_SCHEDULE_V1",
    "database_status_is_derived": true,
    "pass_rule": "Schema-valid, SHA-verified RESULT.json terminal_status=PASS",
    "blocked_rule": "Schema-valid, SHA-verified RESULT.json terminal_status=BLOCKED_EXTERNAL",
    "ready_rule": "PASS 아님 + 모든 depends_on PASS + 동일 worker_slot_uid Active Dispatch 없음 + enabled=true"
  },
  "result_mapping": [
    {"source":"RESULT.json.terminal_status","table":"automation_results","column":"terminal_status"},
    {"source":"RESULT.json.source_commit","table":"automation_results","column":"source_commit"},
    {"source":"RESULT.json.remote_pointer","table":"automation_results","column":"remote_pointer"},
    {"source":"RESULT.json.tests","table":"automation_results","column":"tests_json","encoding":"canonical JSON array"},
    {"source":"RESULT.json.blocker","table":"automation_results","column":"blocker"},
    {"source":"$raw_result_json","table":"automation_results","column":"result_json"},
    {"source":"$result_sha256","table":"automation_results","column":"result_sha256"},
    {"source":"$result_commit_sha","table":"automation_results","column":"result_commit_sha"},
    {"source":"RESULT.json.result_published_at_kst","table":"automation_results","column":"published_at"},
    {"source":"RESULT.json.second_execution_performed","table":"automation_results","column":"second_execution_performed"}
  ],
  "reconciliation": {
    "startup_order": [
      "SQLite foreign_keys 활성화",
      "DB Schema 적용",
      "GitHub EPIC.json Readback",
      "GitHub RESULT.json Readback",
      "WORKER_JOB_SCHEDULE_V1 상태 Readback",
      "로컬 투영 DB 재계산",
      "중복 Dispatch 차단",
      "다음 READY Epic 계산"
    ],
    "database_loss": "GitHub Commit 원장과 기존 Schedule State에서 재생성",
    "github_disagreement": "GitHub Commit 원장이 우선하며 로컬 DB를 덮어씀",
    "pr_comment_disagreement": "댓글은 Pointer이므로 Commit된 JSON이 우선"
  },
  "security": {
    "credentials_allowed": false,
    "tokens_allowed": false,
    "secrets_allowed": false,
    "raw_chat_content_required": false,
    "parameterized_sql_required": true,
    "foreign_keys_required": true,
    "busy_timeout_ms_recommended": 5000,
    "journal_mode_recommended": "WAL",
    "backup_scope": ["automation.db","automation.db-wal","automation.db-shm"],
    "production": false
  }
}
