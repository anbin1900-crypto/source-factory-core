{
  "date": "YYYY-MM-DD",
  "run_id": "SOURCE_FACTORY_DAILY_RUN_YYYYMMDD_001",
  "max_tasks": 10,
  "max_runtime_hours": 8,
  "concurrency": 1,
  "cooldown_after_task_seconds": 120,
  "cooldown_after_error_seconds": 600,
  "max_red_failures": 2,
  "stop_on_black": true,
  "github_commit_each_task": true,
  "tasks": [
    {
      "order": 1,
      "task_id": "EXAMPLE_TASK_001",
      "prompt_path": "daily_queue/YYYY-MM-DD/001_EXAMPLE_TASK.md",
      "output_dir": "runs/YYYY-MM-DD/001_EXAMPLE_TASK",
      "allowed_mode": "REPORT_ONLY",
      "stop_policy": "continue_if_yellow_stop_if_red"
    }
  ]
}
