# Source Factory Core ignore rules

# Python cache / compiled artifacts
__pycache__/
*.py[cod]
*$py.class

# Node dependencies / build outputs
node_modules/
dist/
build/
coverage/
.next/

# Local env / secrets
.env
.env.*
*.pem
*.key
id_rsa
id_dsa
id_ecdsa
id_ed25519

# OS/editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local temporary files
*.tmp
*.log
