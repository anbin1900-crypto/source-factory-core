  "task_status_enum": ["IDLE", "DISPATCHED", "GENERATING", "COMPLETE", "COMPLETE_RESULT_PENDING", "BLOCKED", "UNKNOWN"],
  "browser_sensor_state_enum": ["IDLE", "DISPATCHED", "GENERATING", "COMPLETE", "BLOCKED", "UNKNOWN", "LIKELY_COMPLETE"],
