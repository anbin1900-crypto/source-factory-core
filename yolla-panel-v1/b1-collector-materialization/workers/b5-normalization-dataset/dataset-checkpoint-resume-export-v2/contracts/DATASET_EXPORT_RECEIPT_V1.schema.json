{
  "$id":"DATASET_EXPORT_RECEIPT_V1.schema.json",
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object",
  "required":["schema_version","dataset_id","dataset_version","dataset_sha256","checkpoint_seq","checkpoint_path","checkpoint_sha256","record_count","field_order","round_trip_field_parity","round_trip_record_count_parity","files"],
  "properties":{
    "schema_version":{"const":"DATASET_EXPORT_RECEIPT_V1"},"dataset_id":{"type":"string"},"dataset_version":{"type":"integer","minimum":1},
    "dataset_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"checkpoint_seq":{"type":"integer","minimum":1},"checkpoint_path":{"type":"string"},
    "checkpoint_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"record_count":{"type":"integer","minimum":0},"field_order":{"type":"array","items":{"type":"string"}},
    "round_trip_field_parity":{"const":"PASS"},"round_trip_record_count_parity":{"const":"PASS"},"files":{"type":"object","required":["json","csv","xlsx"]}
  }
}
