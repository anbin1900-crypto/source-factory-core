{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "RESULT_DATASET_LINEAGE_CHECKPOINT_V1.schema.json",
  "type": "object",
  "required": ["schema_version", "command_id", "session_id", "worker_id", "dataset_id", "lineage_key", "checkpoint_seq", "combined_state", "dataset_phase", "record_count", "dataset_sha256"],
  "properties": {
    "schema_version": {"const": "RESULT_DATASET_LINEAGE_CHECKPOINT_V1"},
    "command_id": {"type": "string", "minLength": 1},
    "session_id": {"type": "string", "minLength": 1},
    "worker_id": {"type": "string", "minLength": 1},
    "dataset_id": {"type": "string", "minLength": 1},
    "lineage_key": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "checkpoint_seq": {"type": "integer", "minimum": 1},
    "combined_state": {"enum": ["BROWSER_RUNNING", "COMPLETE_RESULT_PENDING", "RESULT_AVAILABLE"]},
    "dataset_phase": {"enum": ["EMPTY", "PARTIAL", "COMPLETE"]},
    "record_count": {"type": "integer", "minimum": 0},
    "dataset_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
