{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "COMPLETE_RESULT_STATE_V1.schema.json",
  "type": "object",
  "required": ["schema_version", "command_id", "session_id", "worker_id", "dataset_id", "lineage_key", "browser_state", "dataset_state", "combined_state"],
  "properties": {
    "schema_version": {"const": "COMPLETE_RESULT_STATE_V1"},
    "browser_state": {"enum": ["RUNNING", "COMPLETE"]},
    "dataset_state": {"enum": ["NOT_MATERIALIZED", "PARTIAL_DATASET_AVAILABLE", "COMPLETE_DATASET_AVAILABLE"]},
    "combined_state": {"enum": ["BROWSER_RUNNING", "COMPLETE_RESULT_PENDING", "RESULT_AVAILABLE"]}
  },
  "additionalProperties": true
}
