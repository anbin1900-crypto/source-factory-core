{
  "schema_version": "ANALYZER_RESULT_PREVIEW_EXPORT_CONTRACT_V1",
  "directive_id": "A0-SITE-ANALYZER-ADVANCEMENT-WAVE1-AB-BUILD-V1-20260807-001",
  "owner": "B-5",
  "role": "ANALYZER_RESULT_PREVIEW_EDITOR_EXPORT_OWNER",
  "runtime": "NODE_COMMONJS_ELECTRON_COMPATIBLE",
  "external_dependencies": [],
  "input": {
    "accepted_shapes": [
      "Array<RecordObject>",
      "{records:Array<{data:RecordObject,source:SourcePointer}>}"
    ],
    "source_pointer": {
      "rowPointer": "opaque serializable pointer to source artifact/page/row",
      "elementPointers": "field-path keyed locator/node/frame pointers"
    }
  },
  "preview_model": {
    "record_table_auto_shape": true,
    "nested_object_policy": "DOT_PATH_COLUMNS",
    "array_policy": "PRESERVE_VALUE_AND_SERIALIZE_ONLY_FOR_TABLE_CELLS",
    "source_hash": "SHA256_STABLE_SOURCE_RECORDS",
    "operations": [
      "renameField(fieldId,newLabel)",
      "removeField(fieldId)",
      "restoreField(fieldId,order)",
      "orderFields(fieldIds)",
      "setCell(rowId,fieldId,value)"
    ],
    "audit_trail": true,
    "source_input_mutation": false
  },
  "exports": {
    "json": {
      "mime_type": "application/json; charset=utf-8",
      "source_pointers_default": true
    },
    "csv": {
      "mime_type": "text/csv; charset=utf-8",
      "utf8_bom_default": true,
      "rfc4180_quoting": true
    },
    "excel": {
      "mime_type": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
      "format": "XLSX_OPENXML_ZIP",
      "header_freeze": true,
      "auto_filter": true,
      "binary_sha256": true
    }
  },
  "integration": {
    "B2_visual_analyzer": "consume preview() and invoke edit operations",
    "B4_extraction_runner": "supply extraction records with source pointers",
    "B6_runnable_package": "consume index.js, export buffers and manifest",
    "browser_renderer_boundary": "binary export stays in Electron main/preload or Node service"
  },
  "scope_guards": {
    "site_analyzer_only": true,
    "independent_document_pipeline": false,
    "database_work": false,
    "production": false,
    "ready": false,
    "merge": false
  }
}
