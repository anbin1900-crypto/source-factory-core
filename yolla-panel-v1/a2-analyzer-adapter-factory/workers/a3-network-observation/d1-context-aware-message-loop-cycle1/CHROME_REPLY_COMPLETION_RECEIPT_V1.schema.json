{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"CHROME_REPLY_COMPLETION_RECEIPT_V1.schema.json",
  "type":"object",
  "required":["schema_version","cycle_id","role","browser_agent_endpoint","cdp_endpoint","cdp_localhost_only","status","live_pass_claimed","terminal"],
  "properties":{
    "schema_version":{"const":"D4_CHROME_REPLY_COMPLETION_LIVE_RECEIPT_V1"},
