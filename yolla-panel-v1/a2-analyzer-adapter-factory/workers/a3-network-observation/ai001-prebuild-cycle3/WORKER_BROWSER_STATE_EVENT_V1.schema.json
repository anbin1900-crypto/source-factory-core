{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "WORKER_BROWSER_STATE_EVENT_V1",
  "title": "WORKER_BROWSER_STATE_EVENT_V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version","event_id","sequence","observed_at","worker_id","page_id","state",
    "completion_assessment","generating_ui_active","selector_match","reason_codes",
    "technical_pass_claimed","raw_secret_storage"
  ],
  "properties": {
    "schema_version": {"const": "WORKER_BROWSER_STATE_EVENT_V1"},
    "event_id": {"type": "string", "minLength": 8},
    "sequence": {"type": "integer", "minimum": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "worker_id": {"type": "string", "minLength": 1},
    "page_id": {"type": "string", "minLength": 1},
    "previous_state": {"type": ["string","null"], "enum": ["IDLE","DISPATCHED","GENERATING","COMPLETE","BLOCKED","UNKNOWN",null]},
    "state": {"type": "string", "enum": ["IDLE","DISPATCHED","GENERATING","COMPLETE","BLOCKED","UNKNOWN"]},
    "completion_assessment": {"type": "string", "enum": ["NONE","LIKELY_COMPLETE","EXPLICIT_COMPLETE","EXPLICIT_BLOCKED"]},
    "command_id": {"type": ["string","null"]},
    "work_status": {"type": ["string","null"]},
    "terminal": {"type": ["string","null"]},
    "blocker": {"type": ["string","null"]},
    "assistant_message_count": {"type": "integer", "minimum": 0},
    "assistant_digest_sha256": {"type": ["string","null"], "pattern": "^[0-9a-f]{64}$"},
    "generating_ui_active": {"type": "boolean"},
    "dom_stable_ms": {"type": "number", "minimum": 0},
    "selector_strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assistant","generating"],
      "properties": {
        "assistant": {"type": "string"},
        "generating": {"type": "string"}
      }
    },
    "selector_match": {"type": "boolean"},
    "reason_codes": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "technical_pass_claimed": {"const": false},
    "raw_secret_storage": {"const": false}
  }
}
