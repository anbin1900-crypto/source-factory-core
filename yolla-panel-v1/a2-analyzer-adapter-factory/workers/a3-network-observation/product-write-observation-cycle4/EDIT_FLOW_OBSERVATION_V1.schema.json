{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:yolla:a3:edit_flow_observation_v1",
  "title": "EDIT_FLOW_OBSERVATION_V1",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schema_version": {"const": "EDIT_FLOW_OBSERVATION_V1"},
    "event_id": {"type": "string", "minLength": 1},
    "provenance": {"type": "object", "additionalProperties": false, "properties": {"command_id": {"type": "string", "minLength": 1}, "lineage_id": {"type": "string", "minLength": 1}, "page_id": {"type": "string", "minLength": 1}, "action_id": {"type": "string", "minLength": 1}, "timestamp": {"type": "string"}}, "required": ["command_id", "lineage_id", "page_id", "action_id", "timestamp"]},
    "fact_state": {"const": "OBSERVED"},
    "observed": {"type": "object"},
    "inference_candidates": {"type": "array"},
    "redaction": {"type": "object", "additionalProperties": false, "properties": {"applied": {"const": true}, "raw_secret_value_count": {"const": 0}, "raw_pii_value_count": {"const": 0}}, "required": ["applied", "raw_secret_value_count", "raw_pii_value_count"]},
    "consumer_projection": {"type": "object", "required": ["a4", "a5"]}
  },
  "required": ["schema_version", "event_id", "provenance", "fact_state", "observed", "inference_candidates", "redaction"]
}
