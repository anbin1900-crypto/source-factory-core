{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yolla.local/schemas/A4_STRUCTURE_INFERENCE_RESULT_V1.schema.json",
  "title": "A-4 Structure Inference Result V1",
  "type": "object",
  "required": ["schemaVersion","snapshotId","documentUrl","pageType","repeatedRegions","fieldCandidates","locatorCandidates","listDetailRelation","pagination","highlightPayload","stats","resultSha256"],
  "properties": {
    "schemaVersion": {"const": "A4_STRUCTURE_INFERENCE_RESULT_V1"},
    "snapshotId": {"type": "string", "minLength": 1},
    "documentUrl": {"type": "string"},
    "pageType": {
      "type": "object",
      "required": ["type", "confidence"],
      "properties": {
        "type": {"enum": ["LIST","SEARCH_RESULTS","TABLE_LIST","DETAIL","FORM","ARTICLE","UNKNOWN"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "repeatedRegions": {"type": "array", "items": {"type": "object"}},
    "fieldCandidates": {"type": "array", "items": {"type": "object"}},
    "locatorCandidates": {"type": "array", "items": {"type": "object"}},
    "listDetailRelation": {"type": "object"},
    "pagination": {
      "type": "object",
      "required": ["type", "detected", "confidence"],
      "properties": {
        "type": {"enum": ["NEXT","LOAD_MORE","PAGE_NUMBER","CURSOR","INFINITE_SCROLL","NONE"]},
        "detected": {"type": "boolean"},
        "explicitNone": {"type": "boolean"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "highlightPayload": {
      "type": "object",
      "required": ["version", "highlights"],
      "properties": {
        "version": {"const": 1},
        "highlights": {"type": "array", "items": {"type": "object"}}
      }
    },
    "stats": {
      "type": "object",
      "required": ["normalizedNodeCount","repeatedRegionCount","autoFieldCandidateCount","locatorCandidateCount","navigationEventCount"],
      "properties": {
        "normalizedNodeCount": {"type": "integer", "minimum": 1},
        "repeatedRegionCount": {"type": "integer", "minimum": 0},
        "autoFieldCandidateCount": {"type": "integer", "minimum": 0},
        "locatorCandidateCount": {"type": "integer", "minimum": 0},
        "navigationEventCount": {"type": "integer", "minimum": 0}
      }
    },
    "resultSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
