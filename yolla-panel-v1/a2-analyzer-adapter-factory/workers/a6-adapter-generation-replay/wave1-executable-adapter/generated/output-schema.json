{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Extracted records",
  "type": "array",
  "minItems": 1,
  "maxItems": 20,
  "items": {
    "type": "object",
    "additionalProperties": true,
    "required": [
      "id",
      "user_id",
      "title",
      "body"
    ],
    "properties": {
      "id": {
        "type": [
          "string",
          "number"
        ]
      },
      "user_id": {
        "type": [
          "string",
          "number"
        ]
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "body": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
