{
  "schema_version": "A6_WAVE2_EXECUTABLE_ADAPTER_MANIFEST_V1",
  "adapter_id": "a6-wave2-full-input-hybrid-exact10",
  "mode": "HYBRID",
  "entrypoint": "adapter.cjs",
  "drivers": ["LOCAL_HTTP_LIVE", "PLAYWRIGHT_COMPATIBLE_RECIPE", "CRAWLEE_REQUEST_QUEUE_COMPATIBLE"],
  "record_path": "$.items",
  "primary_key": "listingId",
  "pagination": {
    "mode": "PAGE_NUMBER",
    "page_parameter": "page",
    "size_parameter": "size",
    "page_size": 5,
    "max_records": 10,
    "termination": ["EXACT_RECORD_COUNT_10", "NO_NEW_RECORD_IDS", "EMPTY_RESULT"]
  },
  "repair": {
    "scope": "FAILED_STEP_ONLY",
    "endpoint_candidates": ["/api/listing", "/api/listings"],
    "transient_statuses": [429, 500, 502, 503, 504],
    "max_attempts": 3
  },
  "trace_event_families": [
    "analyzer.action",
    "network.requestWillBeSent",
    "network.responseReceived",
    "network.responseBody",
    "adapter.stepFailed",
    "adapter.stepRepaired",
    "adapter.replayComplete"
  ],
  "exact_record_contract": 10,
  "fixture_only_terminal": false
}
