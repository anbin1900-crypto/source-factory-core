    {"when": "BREAKING_SCHEMA_DRIFT", "action": "VERSION_SCHEMA_AND_FAIL_CLOSED_UNTIL_SUCCESSOR_REVIEW", "rerun": "AFTER_UPDATED_EVIDENCE"},
    {"when": "MISSING_DOM_STRUCTURE", "action": "SUPPLY_A4_STRUCTURE_RESULT", "rerun": "MODE_AND_CORRELATION"}
