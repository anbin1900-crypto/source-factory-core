      "no_other_active_directive_for_seat",
      "all_dependencies_terminal_pass",
      "authority_contract_resolved",
      "no_owned_path_or_exclusive_resource_conflict"
    ],
    "action": "PROMOTE_ONE_READY_JOB_TO_ACTIVE_DIRECTIVE",
    "after_pass": "PROMOTE_NEXT_ELIGIBLE_JOB",
    "after_blocked_external": "WAIT_FOR_RESOLUTION_EVENT",
    "after_retryable_failure": "RETRY_SAME_JOB_WITH_SAME_JOB_ID_AND_INCREMENTED_ATTEMPT",
    "after_replan_trigger": "CREATE_REPLAN_REQUEST_FOR_A-1"
  },
  "github_result_acceptance": {
