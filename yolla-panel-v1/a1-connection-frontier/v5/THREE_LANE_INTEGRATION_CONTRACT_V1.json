{
  "schema_version": "YOLLA_THREE_LANE_INTEGRATION_CONTRACT_V1",
  "status": "ACTIVE_DRAFT",
  "runtime": "YOLLA_WORKSPACE_V5_X",
  "principles": {
    "one_runtime": true,
    "three_ownership_lanes": true,
    "single_integration_owner": true,
    "shared_contracts_are_versioned": true,
    "handoff_artifacts_are_immutable": true,
    "extractor_live_dom_dependency_default": false
  },
  "lanes": {
    "AUTOMATION_INTEGRATION": {
      "producer": [
        "WorkerCommandRequest",
        "CycleLedger",
        "RuntimeStatus"
      ],
      "consumer": [
        "AnalysisReceipt",
        "ExtractionReceipt"
      ],
      "owned_paths": [
        "yolla-workspace/runtime/**",
        "yolla-workspace/panel/**",
        "yolla-workspace/worker-automation/**",
        "yolla-workspace/integration/**",
        "yolla-workspace/contracts/common/**"
      ]
    },
    "ANALYZER": {
      "producer": [
        "PageArtifactReceipt",
        "AnalysisReceipt"
      ],
      "consumer": [
        "AnalysisRequest"
      ],
      "owned_paths": [
        "yolla-workspace/analyzer/**",
        "yolla-workspace/contracts/analysis/**",
        "yolla-workspace/adapters/discovery/**"
      ]
    },
    "EXTRACTOR": {
      "producer": [
        "ExtractionResult",
        "ExtractionReceipt"
      ],
      "consumer": [
        "ExtractionRequest",
        "PageArtifactReceipt"
      ],
      "owned_paths": [
        "yolla-workspace/extractor/**",
        "yolla-workspace/contracts/extraction/**",
        "yolla-workspace/adapters/extraction/**"
      ]
    }
  },
  "contracts": {
    "AnalysisRequest": {
      "required": [
        "analysis_id",
        "site_id",
        "requested_url",
        "adapter_id",
        "requested_at"
      ]
    },
    "PageArtifactReceipt": {
      "required": [
        "analysis_id",
        "final_url",
        "page_title",
        "html_sha256",
        "body_text_sha256",
        "screenshot_sha256",
        "link_count",
        "artifact_root",
        "status"
      ]
    },
    "ExtractionRequest": {
      "required": [
        "extraction_id",
        "analysis_id",
        "artifact_receipt",
        "schema_id",
        "adapter_id"
      ]
    },
    "ExtractionResult": {
      "required": [
        "extraction_id",
        "record_count",
        "output_artifact",
        "evidence_count",
        "validation_status",
        "status"
      ]
    }
  },
  "integration_order": [
    "AUTOMATION_SHELL_STABLE",
    "ANALYZER_PAGE_ARTIFACT_PASS",
    "EXTRACTOR_ARTIFACT_TO_RECORD_PASS",
    "AUTOMATION_STATUS_AND_RESULT_PRESENTATION",
    "THREE_LANE_E2E_PASS"
  ],
  "forbidden": [
    "THREE_SEPARATE_ELECTRON_APPLICATIONS",
    "SHARED_UNVERSIONED_CONTRACT_MUTATION",
    "EXTRACTOR_DEFAULT_DIRECT_LIVE_BROWSER_CONTROL",
    "INSTALLER_DELETES_LOGIN_PROFILE",
    "INSTALLER_OVERWRITES_WORKSPACE_STATE",
    "PRODUCTION_WITHOUT_EXPLICIT_APPROVAL",
    "READY_WITHOUT_EXPLICIT_APPROVAL",
    "MERGE_WITHOUT_EXPLICIT_APPROVAL"
  ],
  "production": false,
  "ready": false,
  "merge": false
}
