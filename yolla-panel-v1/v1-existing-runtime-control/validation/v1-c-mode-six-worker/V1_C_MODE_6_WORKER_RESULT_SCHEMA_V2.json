{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "V1_C_MODE_6_WORKER_RESULT_V2",
  "title": "V1 C Mode Six Worker Result",
  "type": "object",
  "required": [
    "schema_version",
    "control_id",
    "worker_id",
    "status",
    "terminal",
    "head_commit",
    "tests",
    "finding_count",
    "work_control_log_preserved",
    "auto_test_write_count"
  ],
  "properties": {
    "schema_version": {"const": "V1_C_MODE_6_WORKER_RESULT_V2"},
    "control_id": {"const": "V1-C-MODE-6W-VALIDATION-CYCLE-002"},
    "worker_id": {"enum": ["AUTOMATION-C-W1", "AUTOMATION-C-W2", "AUTOMATION-C-W3", "AUTOMATION-C-W4", "AUTOMATION-C-W5", "AUTOMATION-C-W6"]},
    "status": {"enum": ["PASS", "BLOCKED_EXTERNAL"]},
    "terminal": {"type": "string", "minLength": 8},
    "head_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "tests": {"type": "array", "minItems": 1},
    "finding_count": {"type": "integer", "minimum": 0},
    "fix_count": {"type": "integer", "minimum": 0},
    "work_control_log_preserved": {"const": true},
    "auto_test_write_count": {"const": 0},
    "target_pc_evidence": {"type": ["object", "null"]},
    "exact_blocker": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
