que producer-native version or revision reference; not a D canonical document_version_id."},"raw_text":{"type":"string","min_length":1,"preservation":"EXACT_CODEPOINT_SEQUENCE_NO_TRIM_NO_NFC_REWRITE","d_mapping":"B016 -> FRAGMENT.raw_text"},"content_hash":{"type":"sha256_lowercase_hex","algorithm":"SHA-256","input":"exact UTF-8 bytes of raw_text","d_mapping":"B018 -> FRAGMENT.content_hash"},"source_sha256":{"type":"sha256_lowercase_hex","algorithm":"SHA-256","input":"exact immutable upstream source artifact bytes","semantics":"Must not be recomputed from fragment raw_text unless fragment bytes are the entire source artifact."},"locator":{"type":"object","required_fields":["locator_type","native_locator"],"allowed_locator_types":["SOURCE_FIELD_PATH","JSON_POINTER","HTML_DOM","PDF_PAGE_REGION","TEXT_OFFSET","TABLE_CELL","CLAUSE","SECTION","FORM_FIELD"],"d_mapping":"B017 -> FRAGMENT.locator","pagination_policy":"No page, row, or region may be invented when absent from the source."},"source_span":{"type":"object","required_fields":["span_unit","start_inclusive","end_exclusive","span_text","span_text_hash"],"span_unit":"UNICODE_CODE_POINT","interval":"[start_inclusive,end_exclusive)","integrity":"source_document_text[start_inclusive:end_exclusive] == span_text == raw_text","locator_binding":"Until D-1 publishes a dedicated span field, the exact span is carried as a validated locator extension and evidence attribute."},"evidence_refs":{"type":"array","min_items":1,"item_required_fields":["evidence_ref_id","source_record_id","source_sha256","locator","quote","quote_hash"],"semantics":"C-side opaque evidence references only; no D evidence_link_id, assertion_id, fragment_id, or document_version_id is generated."},"d_binding":{"type":"object","required_fields":["fragment_id","document_version_id","generation_authority","binding_status"],"required_values":{"fragment_id":null,"document_version_id":null,"generation_authority":"D-1_ONLY","binding_status":"PENDING_D1_CANONICAL_BINDING"}}}},"d_compatibility_mapping":[{"inbound_field":"source_record_id","d_rule":"B010","target":"DOCUMENT.source_native_id","status":"DIRECT_COMPATIBLE"},{"inbound_field":"raw_text","d_rule":"B016","target":"FRAGMENT.raw_text","status":"DIRECT_COMPATIBLE"},{"inbound_field":"locator","d_rule":"B017","target":"FRAGMENT.locator","status":"DIRECT_COMPATIBLE"},{"inbound_field":"content_hash","d_rule":"B018","target":"FRAGMENT.content_hash","status":"DIRECT_COMPATIBLE"},{"inbound_field":"source_sha256","d_rule":"B009/C016","target":"ARTIFACT.source_sha256/EVIDENCE_LINK.source_sha256","status":"DIRECT_COMPATIBLE"},{"inbound_field":"evidence_refs[*].quote","d_rule":"C013","target":"EVIDENCE_LINK.quote","status":"DIRECT_COMPATIBLE"},{"inbound_field":"evidence_refs[*].quote_hash","d_rule":"C014","target":"EVIDENCE_LINK.quote_hash","status":"DIRECT_COMPATIBLE"},{"inbound_field":"document_native_ref/document_version_ref","d_rule":null,"target":"D-1 canonical lookup/generation input","status":"OPAQUE_NATIVE_REFERENCE_PENDING_D1_BINDING"},{"inbound_field":"source_span","d_rule":null,"target":"FRAGMENT.locator extension/EVIDENCE_LINK.locator","status":"CONTRACT_PREPARED_PENDING_D1_FRAGMENT_RECONCILIATION"}],"hash_canonicalization":{"encoding":"UTF-8","unicode_normalization_before_hash":"NONE","line_ending_normalization_before_hash":"NONE","content_hash_formula":"lowerhex(sha256(raw_text.encode('utf-8')))","span_text_hash_formula":"lowerhex(sha256(span_text.encode('utf-8')))","quote_hash_formula":"lowerhex(sha256(quote.encode('utf-8')))","source_sha256_formula":"lowerhex(sha256(exact_source_artifact_bytes))"},"validation_rules":["All required fields must be present.","source_record_id, document_native_ref, and document_version_ref must be non-empty strings.","raw_text must be preserved exactly and must be non-empty.","content_hash must match exact UTF-8 raw_text bytes.","source_sha256 must be lowercase 64-hex and must match every evidence reference.","locator_type must be allowed and native_locator must be non-empty.","source_span must use Unicode code-point offsets with start >= 0 and end > start.","source span must be in bounds of the supplied source document text.","source span text must equal both the source slice and raw_text.","span_text_hash must match exact UTF-8 span_text bytes.","At least one evidence reference is required.","Evidence quote must equal raw_text for direct fragment evidence and quote_hash must match.","D canonical fragment_id and document_version_id must remain null.","Semantic inference fields are not permitted in this contract."],"rejection_reasons":["REQUIRED_FIELD_MISSING","EMPTY_NATIVE_REFERENCE","RAW_TEXT_EMPTY","LOCATOR_INVALID","SOURCE_SPAN_INVALID","SOURCE_SPAN_OUT_OF_BOUNDS","SOURCE_SPAN_TEXT_MISMATCH","CONTENT_HASH_MISMATCH","SPAN_TEXT_HASH_MISMATCH","SOURCE_SHA256_INVALID","SOURCE_SHA256_EVIDENCE_MISMATCH","EVIDENCE_REF_MISSING","QUOTE_TEXT_MISMATCH","QUOTE_HASH_MISMATCH","D_CANONICAL_ID_GENERATION_FORBIDDEN","SEMANTIC_INFERENCE_FIELD_FORBIDDEN"],"safety":{"source_text_silent_drop":false,"semantic_inference":false,"d_canonical_id_generation":false,"d_canonical_schema_mutation":false,"d_canonical_db_write":false,"actual_bulk_collection":false,"production":false,"ready":false,"merge":false},"status":"CONTRACT_PREPARED_FIXTURE_VALIDATION_REQUIRED"}
