    "consumer": {
      "prefix": "/real-estate",
      "shell": "SearchShell",
      "audiences": ["ANONYMOUS", "CONSUMER"],
      "visual_density": "LOW_TO_MEDIUM",
      "forbidden_surfaces": ["TaskQueue", "internal_customer_data", "office_internal_documents", "ranking_evidence_ledger", "staff_assignment"]
    },
    "broker": {
      "prefix": "/broker",
      "shell": "DesktopShell",
      "audiences": ["ACTIVE_OFFICE_MEMBER", "AUTHORIZED_PLATFORM_ADMIN_CASE_SCOPE"],
      "visual_density": "MEDIUM_TO_HIGH",
      "server_guards": ["account_active", "office_link_active", "membership_active", "route_permission"],
      "consumer_shell_embedding": false
    }
  },
  "shell_components": {
    "DesktopShell": {
      "owns": ["global_layout", "office_context", "membership_context", "active_tabs", "tab_restore", "global_notifications", "session_expiry", "keyboard_shortcuts"],
      "must_not_own": ["domain_persistence", "ranking_calculation", "crm_state_machine", "document_approval", "listing_authorization_decision"]
    },
    "WorkTab": {
      "workspace_key": "object_type + ':' + object_id + ':' + view_mode",
      "types": ["LIST", "DETAIL", "EDIT", "COMPARE", "DOCUMENT", "REPORT", "EXTERNAL_SOURCE"],
      "rules": ["same_workspace_key_activates_existing_tab", "tab_state_isolated", "unsaved_changes_guard", "authorization_rechecked_on_activation"],
      "detached_window": {"allowed": true, "modes": ["DETAIL", "COMPARE", "DOCUMENT", "REPORT"], "sensitive_values_in_url": false, "authorization_recheck": true}
    },
    "TaskQueue": {
      "states": ["NEW", "READY", "IN_PROGRESS", "WAITING_EXTERNAL", "DONE", "CANCELLED"],
      "sources": ["USER", "RULE_ENGINE", "DATA_UPDATE", "INQUIRY", "DOCUMENT_EXPIRY", "CORRECTION_REQUEST"],
      "required_fields": ["task_id", "task_type", "title", "priority", "due_at", "assignee_id", "office_id", "related_object_refs", "status", "source", "created_at", "updated_at"],
      "ai_required": false
    },
    "RightAssistantPanel": {
      "modes": ["AI_ENABLED", "RULE_TEMPLATE_FALLBACK", "HELP_ONLY"],
      "allowed": ["context_summary", "next_action_suggestions", "checklist", "template_recommendations"],
      "forbidden": ["silent_save", "silent_send", "silent_classification_change", "contract_finalization", "TOP_SECRET_prompt_input"]
    }
  },
